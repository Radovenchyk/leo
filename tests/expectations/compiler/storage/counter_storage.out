program test.aleo;

struct Optional__EsDmm5O6sv6:
    is_some as boolean;
    val as u32;

mapping counter__:
    key as boolean.public;
    value as u32.public;

function initialize:
    async initialize into r0;
    output r0 as test.aleo/initialize.future;

finalize initialize:
    set 0u32 into counter__[false];

function increment:
    async increment into r0;
    output r0 as test.aleo/increment.future;

finalize increment:
    contains counter__[false] into r0;
    get.or_use counter__[false] 0u32 into r1;
    cast true r1 into r2 as Optional__EsDmm5O6sv6;
    cast false 0u32 into r3 as Optional__EsDmm5O6sv6;
    ternary r0 r2 r3 into r4;
    contains counter__[false] into r5;
    get.or_use counter__[false] 0u32 into r6;
    cast true r6 into r7 as Optional__EsDmm5O6sv6;
    cast false 0u32 into r8 as Optional__EsDmm5O6sv6;
    ternary r5 r7 r8 into r9;
    ternary r4.is_some r9.val 0u32 into r10;
    add r10 1u32 into r11;
    set r11 into counter__[false];
    contains counter__[false] into r12;
    get.or_use counter__[false] 0u32 into r13;
    cast true r13 into r14 as Optional__EsDmm5O6sv6;
    cast false 0u32 into r15 as Optional__EsDmm5O6sv6;
    ternary r12 r14 r15 into r16;
    assert.eq r16.is_some true;
    contains counter__[false] into r17;
    get.or_use counter__[false] 0u32 into r18;
    cast true r18 into r19 as Optional__EsDmm5O6sv6;
    cast false 0u32 into r20 as Optional__EsDmm5O6sv6;
    ternary r17 r19 r20 into r21;
    is.eq r21.val r11 into r22;
    assert.eq r22 true;

constructor:
    assert.eq edition 0u16;
